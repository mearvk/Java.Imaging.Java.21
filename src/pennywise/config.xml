<?xml version="1.0" encoding="UTF-8"?>
<config>
    <user>{USER}</user>

    <!-- Paths use {USER} placeholder, resolved at runtime per OS -->
    <source>{HOME}/Desktop/Photos</source>

    <destinations>
        <images>{HOME}/Desktop/Organized/Images</images>
        <videos>
            <mov>{HOME}/Desktop/Organized/Videos/MOVs</mov>
            <mp4>{HOME}/Desktop/Organized/Videos/MP4s</mp4>
            <mpeg>{HOME}/Desktop/Organized/Videos/MPEGs</mpeg>
            <avi>{HOME}/Desktop/Organized/Videos/AVIs</avi>
        </videos>
    </destinations>

    <filetypes>
        <images>.jpg,.jpeg,.heic,.png,.tiff,.tif,.bmp,.gif,.webp</images>
        <videos>.mov,.mp4,.mpeg,.mpg,.avi,.m4v</videos>
    </filetypes>

    <security>
        <local-public-key>src/science/public.key</local-public-key>
        <remote-public-key>https://raw.githubusercontent.com/mearvk/Java.Web.Server.Telnet.Front.Java.21/main/psychiatry/secrets/public.key</remote-public-key>
    </security>

    <entertainment>
        <source-url>https://api.github.com/repos/mearvk/Java.Web.Server.Telnet.Front.Java.21/contents/black.belt/sharp</source-url>
        <poll-ratio>1/7</poll-ratio>
        <ollama-endpoint>http://localhost:11434/api/generate</ollama-endpoint>
        <ollama-model>llama3</ollama-model>
    </entertainment>
</config>
